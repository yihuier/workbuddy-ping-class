{
  "name": "ping-class",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && node scripts/verify-workbuddy.mjs && npm run test:release && npm run check:public",
    "build:only": "vite build",
    "check:public": "node scripts/check-public-repository.mjs",
    "setup:local": "node scripts/create-local-config.mjs",
    "test:release": "node scripts/test-release-cardinality.mjs",
    "package:agent": "node scripts/package-agent-release.mjs",
    "package:workbuddy": "node scripts/package-workbuddy.mjs",
    "verify:workbuddy": "node scripts/verify-workbuddy.mjs",
    "verify:workbuddy:official": "node scripts/verify-workbuddy.mjs --require-official"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
